<Window x:Class="Relight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relight" Width="1080" Height="740" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/Relight.ico"
        UseLayoutRounding="True" AutomationProperties.Name="Relight dashboard">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ApplicationsCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding HistoryCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SettingsCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding HideCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding ExitCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Padding="20,28,20,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource FlameImage}" Width="32" Height="32" Margin="0,0,10,0" />
                        <TextBlock Text="Relight" FontWeight="SemiBold" FontSize="26" />
                    </StackPanel>
                    <TextBlock Text="A little peace of mind." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />
                    <TextBlock Text="DEVELOPMENT PREVIEW" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Version 0.1.0" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16" />
                    <Button Content="Hide to tray" Command="{Binding HideCommand}" ToolTip="Close this window and keep Relight in the tray (Ctrl+W)." Margin="0,0,0,8" />
                    <Button Content="E_xit Relight" Command="{Binding ExitCommand}" ToolTip="Exit Relight (Ctrl+Q)." />
                </StackPanel>
                <StackPanel>
                    <RadioButton Content="_Applications" GroupName="Page" Style="{StaticResource Navigation}"
                                 IsChecked="{Binding IsApplications, Mode=TwoWay}" ToolTip="Applications (Ctrl+1)" />
                    <RadioButton Content="_History" GroupName="Page" Style="{StaticResource Navigation}"
                                 IsChecked="{Binding IsHistory, Mode=TwoWay}" ToolTip="History (Ctrl+2)" />
                    <RadioButton Content="_Settings" GroupName="Page" Style="{StaticResource Navigation}"
                                 IsChecked="{Binding IsSettings, Mode=TwoWay}" ToolTip="Settings (Ctrl+3)" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{Binding Heading}" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,24">
                <TextBlock Foreground="{DynamicResource AccentBrush}" Text="{Binding MonitoringBanner}" TextWrapping="Wrap" />
            </Border>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel Visibility="{Binding IsApplications, Converter={StaticResource VisibleWhenTrue}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,28">
                                    <Button DockPanel.Dock="Right" Content="+ Add application"
                                            Command="{Binding AddCommand}"
                                            ToolTip="Register an executable application for protection." />
                                    <StackPanel>
                                        <TextBlock Text="Your applications" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ApplicationCountText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,16"
                                           Visibility="{Binding HasApplications, Converter={StaticResource VisibleWhenTrue}}">
                                    <ComboBox ItemsSource="{Binding ApplicationFilters}"
                                              SelectedItem="{Binding SelectedApplicationFilter}"
                                              DisplayMemberPath="Label" Width="190" Margin="0,0,12,0"
                                              AutomationProperties.Name="Filter applications by status" />
                                    <ComboBox ItemsSource="{Binding ApplicationSorts}"
                                              SelectedItem="{Binding SelectedApplicationSort}"
                                              DisplayMemberPath="Label" Width="165"
                                              AutomationProperties.Name="Sort applications" />
                                </WrapPanel>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />
                                <StackPanel HorizontalAlignment="Center" MaxWidth="430" Margin="16,42,16,42"
                                            Visibility="{Binding HasNoApplications, Converter={StaticResource VisibleWhenTrue}}">
                                    <Image Source="{StaticResource FlameImage}" Width="56" Height="56" Margin="0,0,0,20" />
                                    <TextBlock Text="A place for your everyday apps" TextAlignment="Center" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Add an executable application to begin. Installed-app selection and advanced settings are still in development."
                                               Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                                <TextBlock Text="No applications match this filter."
                                           Style="{StaticResource Muted}" Margin="8,22,8,12"
                                           Visibility="{Binding HasNoVisibleApplications, Converter={StaticResource VisibleWhenTrue}}" />
                                <ItemsControl ItemsSource="{Binding ApplicationRows}"
                                              Visibility="{Binding HasApplications, Converter={StaticResource VisibleWhenTrue}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,14">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding State}" DockPanel.Dock="Right" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding NextAction}" TextWrapping="Wrap"
                                                               Margin="0,8,0,0" FontWeight="SemiBold" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding Attempts}" Style="{StaticResource Muted}"
                                                                   Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding LastSeen}" Style="{StaticResource Muted}"
                                                                   Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding Instance}" Style="{StaticResource Muted}"
                                                                   Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding LastOutage}" Style="{StaticResource Muted}"
                                                                   Margin="0,0,16,4" />
                                                        <TextBlock Text="{Binding LastAutomaticRecovery}" Style="{StaticResource Muted}"
                                                                   Margin="0,0,16,4" />
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <Button Content="Start now" IsEnabled="{Binding CanStartNow}"
                                                                Click="StartNowClick" Margin="0,0,10,8" />
                                                        <Button Content="Stop and pause" IsEnabled="{Binding CanStopAndPause}"
                                                                Click="StopAndPauseClick" Margin="0,0,10,8"
                                                                ToolTip="Ask this verified application to close gracefully, then pause protection. A force-close choice appears only if it does not exit." />
                                                        <Button Content="{Binding PauseResumeLabel}"
                                                                IsEnabled="{Binding CanPauseResume}"
                                                                Click="PauseResumeClick" Margin="0,0,10,8" />
                                                        <Button Content="Reset recovery" IsEnabled="{Binding CanReset}"
                                                                Click="ResetRecoveryClick" Margin="0,0,10,8" />
                                                        <Button Content="{Binding EnableDisableLabel}"
                                                                IsEnabled="{Binding CanToggleEnabled}"
                                                                Click="EnableDisableClick" Margin="0,0,10,8"
                                                                ToolTip="Disabling protection leaves the application running and preserves its recovery budget." />
                                                        <Button Content="View history" Click="ViewProfileHistoryClick"
                                                                Margin="0,0,10,8" />
                                                        <Button Content="Edit policy" IsEnabled="{Binding CanEdit}"
                                                                Click="EditProfileClick" Margin="0,0,10,8" />
                                                        <Button Content="Remove profile" IsEnabled="{Binding CanRemove}"
                                                                Click="RemoveProfileClick" Margin="0,0,10,8"
                                                                ToolTip="Remove this profile; the application keeps running." />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Closing this window keeps Relight in the system tray. Double-click its tray icon to return."
                                   Style="{StaticResource Muted}" Margin="4,18,4,0" />
                    </StackPanel>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                            Visibility="{Binding IsHistory, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="Event history" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Local records of monitoring and recovery. Times below use this computer's time zone."
                                       Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16" />
                            <WrapPanel Margin="0,0,0,12">
                                <ComboBox ItemsSource="{Binding HistoryProfiles}" SelectedItem="{Binding SelectedHistoryProfile}"
                                          DisplayMemberPath="Label" Width="174" Margin="0,0,8,8"
                                          AutomationProperties.Name="Filter history by application" />
                                <ComboBox ItemsSource="{Binding HistorySeverities}" SelectedItem="{Binding SelectedHistorySeverity}"
                                          DisplayMemberPath="Label" Width="154" Margin="0,0,8,8"
                                          AutomationProperties.Name="Filter history by severity" />
                                <ComboBox ItemsSource="{Binding HistoryKinds}" SelectedItem="{Binding SelectedHistoryKind}"
                                          DisplayMemberPath="Label" Width="174" Margin="0,0,8,8"
                                          AutomationProperties.Name="Filter history by event type" />
                                <ComboBox ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding SelectedHistoryRange}"
                                          DisplayMemberPath="Label" Width="130" Margin="0,0,8,8"
                                          AutomationProperties.Name="Filter history by time range" />
                            </WrapPanel>
                            <TextBlock Text="Episode ID (optional)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding HistoryEpisodeText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Optional episode ID. Copy it from an event's details."
                                     AutomationProperties.Name="Filter history by episode ID"
                                     Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Refresh history" Command="{Binding RefreshHistoryCommand}" Margin="0,0,10,0" />
                                <Button Content="Export filtered history" Click="ExportHistoryClick" Margin="0,0,10,0" />
                                <Button Content="Open log folder" Click="OpenLogFolderClick" />
                            </StackPanel>
                            <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                    Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="{Binding HistorySummaryText}" TextWrapping="Wrap" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding HistoryRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Expander>
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding LocalTime}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                                            <TextBlock Text="{Binding Profile}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                                            <TextBlock Text="{Binding Severity}" Style="{StaticResource Muted}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True"
                                                         TextWrapping="Wrap" BorderThickness="0" Padding="8"
                                                         Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" />
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource VisibleWhenTrue}}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Application behavior" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <TextBlock Text="Close to tray" FontWeight="SemiBold" />
                                <TextBlock Text="The close button hides the dashboard. Use Exit Relight to quit." Style="{StaticResource Muted}" Margin="0,4,0,18" />
                                <CheckBox x:Name="StartAtSignInInput" Content="Start Relight when I sign in"
                                          IsEnabled="{Binding CanChangeStartAtSignIn}"
                                          IsChecked="{Binding StartAtSignIn, Mode=OneWay}"
                                          AutomationProperties.Name="Start Relight when I sign in"
                                          Click="StartAtSignInClick" />
                                <TextBlock Text="{Binding StartAtSignInStatus}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="22,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Local data" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Configuration and log location:" Style="{StaticResource Muted}" Margin="0,12,0,8" />
                                <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="4,6"
                                         TextWrapping="Wrap" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
                                         AutomationProperties.Name="Local data directory" />
                                <Button Content="Restore last-good configuration"
                                        Command="{Binding RepairConfigurationCommand}"
                                        IsEnabled="{Binding CanRepairConfiguration}"
                                        AutomationProperties.Name="Restore last-good configuration"
                                        Margin="0,16,0,0" HorizontalAlignment="Left" />
                                <TextBlock Text="When the current configuration is invalid, this restores the last-good backup, preserves the invalid file, and restarts monitoring. Review the backup before continuing."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Button Content="Export diagnostic bundle" Click="ExportDiagnosticsClick"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"
                                        AutomationProperties.Name="Export local diagnostic bundle" />
                                <TextBlock Text="Creates a local ZIP with application and OS versions, redacted settings, and up to 500 recent events. Target identities, arguments, working directories and process paths are omitted. Choose a destination outside Relight's data folder."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="3" Text="{Binding FooterStatus}" Style="{StaticResource Muted}"
                       FontSize="12" Margin="0,24,0,0" />
        </Grid>
    </Grid>
</Window>
