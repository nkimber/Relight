<UserControl x:Class="Relight.StorageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.Name="Storage workspace">
    <DockPanel>
        <Button DockPanel.Dock="Top" Content="Monitoring settings…" Click="SettingsClick" HorizontalAlignment="Right" Margin="0,0,0,12" />
        <TabControl x:Name="Sections" SelectionChanged="SectionChanged" AutomationProperties.Name="Storage sections">
            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
                    <TextBlock Text="Drive capacity" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Fixed local drives. Monitoring continues in the tray. Scans and cleanup only run when requested or separately approved."
                               TextWrapping="Wrap" Margin="0,8,0,16" />
                    <TextBlock x:Name="ReadingsText" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageReadings" />
                    <TextBlock x:Name="AutomaticText" TextWrapping="Wrap" Margin="0,12,0,12" />
            <TextBlock Text="Reminders repeat while a drive remains low. Snooze quiets all disk-space warning/critical notices in this Relight instance. Readings and tray attention continue while monitoring is enabled; recovery and cleanup settings are unchanged. Snooze ends when its time expires or Relight exits."
                       TextWrapping="Wrap" Margin="0,12,0,8" />
            <WrapPanel>
                <Label Target="{Binding ElementName=SnoozeInput}" Content="Snooze minutes (5–1440)" />
                <TextBox x:Name="SnoozeInput" Text="60" Width="70" AutomationProperties.Name="Storage notification snooze minutes" />
                <Button x:Name="SnoozeButton" Content="Snooze disk-space notifications" Click="SnoozeClick" Margin="8,0" />
                <Button x:Name="ResumeButton" Content="Resume disk-space notifications" Click="ResumeClick" />
            </WrapPanel>
            <TextBlock x:Name="SnoozeStatus" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="StorageSnoozeStatus" />

                    <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Space usage" x:Name="UsageTab">
                <DockPanel x:Name="UsagePanel">
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2" Padding="24" Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.AutomationId="ActiveScanPanel">
                    <StackPanel>
                        <TextBlock Text="Scan in progress" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{Binding ActiveRoot}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8" />
                        <ProgressBar IsIndeterminate="True" Height="8" Margin="0,8,0,16" AutomationProperties.Name="Scan activity" />
                        <TextBlock Text="{Binding Status}" FontSize="16" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding ProgressSummary}" FontSize="15" Margin="0,12,0,16" />
                        <Button Content="Cancel scan" Click="CancelScanClick" IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" />
                        <TextBlock Text="Previous results are hidden while this scan runs. Canceling keeps the previous saved results."
                                   TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                        Padding="16" Margin="0,0,0,16" Visibility="{Binding ShowCoverageWarning, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.AutomationId="ScanCoverageWarning">
                    <StackPanel>
                        <TextBlock Text="{Binding CoverageWarningTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="{Binding CoverageWarning}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowScanContent, Converter={StaticResource VisibleWhenTrue}}">
            <StackPanel x:Name="ScanPanel" Margin="0,28,0,0">
                <TextBlock Text="Where is the space going?" FontSize="22" FontWeight="SemiBold" />
                <Label Content="Maximum entries per scan (files + folders; 1–10000000)" Target="{Binding ElementName=ScanLimitInput}" />
                <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,8">
                    <TextBox x:Name="ScanLimitInput" Width="130" AutomationProperties.Name="Scan entry limit" />
                    <Button Content="Save scan limit" Click="SaveScanLimitClick" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="ScanLimitStatus" TextWrapping="Wrap" />
                <TextBlock Text="Larger limits take longer and use more memory. Saving a limit does not start or resume a scan; start a new scan to apply it."
                           TextWrapping="Wrap" Margin="0,8,0,8" />
                <TextBlock Text="Analyze a local folder or drive. Sizes identify consumers, not safe cleanup candidates. Reparse points and cloud/offline entries are skipped."
                           TextWrapping="Wrap" Margin="0,8,0,8" />
                <Label Target="{Binding ElementName=ScanRootInput}" Content="Folder or drive to analyze" />
                <TextBox x:Name="ScanRootInput" Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Folder to analyze" />
                <WrapPanel Margin="0,8,0,8">
                    <Button Content="Browse scan folder…" Click="BrowseScanClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                    <Button Content="Scan folder" Click="ScanClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                </WrapPanel>
                <TextBlock Text="{Binding ScanAge}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding ResultsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Logical size counts file paths. Allocated space counts each file identity once, charged to its first encountered path; folder totals overlap. These are measured file-stream bytes, not guaranteed reclaimable space. Directory overhead, alternate streams and excluded entries are not measured."
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding FilesHeading}" FontSize="18" />
                <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Height="190" Margin="0,8,0,16" AutomationProperties.Name="Largest files">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Logical size" Binding="{Binding LogicalMiB, StringFormat='{}{0:N2} MiB'}" Width="110" />
                        <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedMiB, StringFormat='{}{0:N2} MiB'}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding FoldersHeading}" FontSize="18" />
                <DataGrid ItemsSource="{Binding Folders}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Height="190" Margin="0,8,0,16" AutomationProperties.Name="Largest folders">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Logical size" Binding="{Binding LogicalMiB, StringFormat='{}{0:N2} MiB'}" Width="100" />
                        <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedMiB, StringFormat='{}{0:N2} MiB'}" Width="100" />
                        <DataGridTextColumn Header="Coverage" Binding="{Binding Coverage}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="What grew?" FontSize="18" />
                <TextBlock Text="{Binding BaselineStatus}" TextWrapping="Wrap" Margin="0,8,0,8" />
                <DataGrid ItemsSource="{Binding Growth}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Height="160" AutomationProperties.Name="Storage growth">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Logical growth" Binding="{Binding Growth}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Coverage issues (up to 100)" FontSize="18" Margin="0,16,0,8" />
                <DataGrid ItemsSource="{Binding Issues}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" Height="160" AutomationProperties.Name="Scan coverage issues">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Location" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Scans continue across navigation and hiding the dashboard. Cancel or exit Relight to stop the scan. One latest scan is saved locally for comparison; scanning a different root replaces that baseline. Traversal uses your saved entry limit and depth 128; retained rankings stay bounded."
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>

                </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Cleanup rules"><ContentControl x:Name="RulesContent" /></TabItem>
            <TabItem Header="Cleanup history"><ContentControl x:Name="HistoryContent" /></TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
