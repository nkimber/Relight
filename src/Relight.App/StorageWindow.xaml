<Window x:Class="Relight.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relight — Storage" Width="900" Height="640" MinWidth="720" MinHeight="500"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Disk space monitoring" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Checks continue when this window closes. Only fixed local drives are supported. No files are scanned or deleted."
                       TextWrapping="Wrap" Margin="0,8,0,16" />
            <CheckBox x:Name="EnabledInput" Content="Enable disk space monitoring" Margin="0,0,0,8" />
            <CheckBox x:Name="NotificationsInput" Content="Notify when a drive enters warning or critical space" Margin="0,0,0,12" />
            <Label Target="{Binding ElementName=IntervalInput}" Content="Check interval in seconds (10–3600)" />
            <TextBox x:Name="IntervalInput" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Storage check interval seconds" />
            <TextBlock Text="Thresholds use percent OR GiB free. Critical values must be lower than warning values. Enter a drive root such as C:\. Empty drive list uses the system drive with default thresholds."
                       TextWrapping="Wrap" Margin="0,16,0,8" />
            <DataGrid x:Name="DrivesInput" AutoGenerateColumns="False" CanUserAddRows="True"
                      CanUserDeleteRows="True" MinHeight="120" AutomationProperties.Name="Drive thresholds">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drive" Binding="{Binding Root}" Width="*" />
                    <DataGridTextColumn Header="Warning %" Binding="{Binding WarningPercent}" Width="*" />
                    <DataGridTextColumn Header="Critical %" Binding="{Binding CriticalPercent}" Width="*" />
                    <DataGridTextColumn Header="Warning GiB" Binding="{Binding WarningGigabytes}" Width="*" />
                    <DataGridTextColumn Header="Critical GiB" Binding="{Binding CriticalGigabytes}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Button x:Name="SaveButton" Content="Save storage settings" Click="SaveClick" HorizontalAlignment="Left" Margin="0,12,0,12" />
            <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" />
            <TextBlock Text="Latest readings" FontSize="18" Margin="0,16,0,8" />
            <TextBlock x:Name="ReadingsText" TextWrapping="Wrap" />
            <TextBlock Text="Alerts clear above both warning thresholds plus 2 percentage points and 1 GiB. Notifications use the Windows tray and may be suppressed by Windows settings."
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
