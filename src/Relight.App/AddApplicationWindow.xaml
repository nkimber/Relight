<Window x:Class="Relight.AddApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add application · Relight" Width="650" Height="650"
        MinWidth="520" MinHeight="500" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" Closing="WindowClosing"
        AllowDrop="True" PreviewDragOver="WindowDragOver" PreviewDrop="WindowDrop">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Add an application" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,20" Style="{StaticResource Muted}"
                   Text="Choose an executable or the selected ChatGPT installation. Relight verifies its current-session identity before protection starts." TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Application name" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="NameInput" MinHeight="32" MaxLength="100" TextChanged="NameChanged"
                     AutomationProperties.Name="Application name" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="ExecutableOption" Content="Executable file" IsChecked="True"
                         Checked="TargetChanged" GroupName="TargetKind" Margin="0,0,20,0" />
            <RadioButton x:Name="ChatGptOption" Content="Installed ChatGPT"
                         Checked="TargetChanged" GroupName="TargetKind" />
        </StackPanel>
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Grid>
                    <StackPanel x:Name="ExecutableFields">
                        <TextBlock Text="Executable file" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Click="BrowseClick" Margin="8,0,0,0" />
                            <Button x:Name="ChooseRunningButton" DockPanel.Dock="Right" Content="Choose running…"
                                    Click="ChooseRunningClick" Margin="8,0,0,0" />
                            <TextBox x:Name="PathInput" MinHeight="32" TextChanged="PathChanged"
                                     AutomationProperties.Name="Executable file path" />
                        </DockPanel>
                        <TextBlock Text="You can also drop one .exe file here. Packaged apps require an installed-app adapter."
                                   Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                        <TextBlock Text="Launch arguments · one argument per line (optional; outer spaces trimmed)"
                                   FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBox x:Name="ArgumentsInput" MinHeight="62" MaxHeight="110"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Launch arguments, one per line" />
                        <TextBlock Text="Working directory · full path (optional)"
                                   FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBox x:Name="WorkingDirectoryInput" MinHeight="32"
                                 AutomationProperties.Name="Working directory" />
                    </StackPanel>
                    <TextBlock x:Name="InstalledIdentityText" Visibility="Collapsed" TextWrapping="Wrap"
                               Text="Windows installed app: OpenAI.Codex_2p2nqsd0c76g0!App. Relight identifies the main process by package family and current session; helper processes are not treated as the app." />
                </Grid>
                <StackPanel Margin="0,14,0,12">
                    <Button x:Name="DetectButton" Content="Detect now" Click="DetectClick"
                            HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <TextBlock x:Name="DetectionText" Text="Select a file, then choose Detect now."
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <CheckBox x:Name="InitialStartInput" Margin="0,16,0,8"
                              Content="Start automatically if initially absent"
                              Checked="InitialStartChanged" Unchecked="InitialStartChanged" />
                    <TextBlock x:Name="PolicyPreviewText" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Adding protection never closes an existing application. Other recovery settings can be changed later in Edit profile." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button x:Name="AddButton" Content="Add and protect" IsEnabled="False"
                    Click="AddClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
